# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="models/gemini-2.5-flash-lite" # You can change this to anything you prefer

# Processing limits
BATCH_SIZE=10 #Number of rows (feedbacks) per batch the tool will process
MAX_ROWS=80 #Adjust this number to set the maximum number of feedbacks (rows of data) the tool can analyze

